<th>Value of each '<span class="double-strike">M</span>' game stamp</th>
<th>Total '<span class="double-strike">M</span>' value per color</th>
</tr>
</thead>
<tbody>
<tr><td><span style="background-color:#0066cc;color:white;padding:2px 8px;border-radius:3px;">Blue</span></td><td style="text-align:right;">7,149,999</td><td style="text-align:right;">10</td><td style="text-align:right;">71,499,990</td></tr>
<tr><td><span style="background-color:#28a745;color:white;padding:2px 8px;border-radius:3px;">Green</span></td><td style="text-align:right;">6,000,000</td><td style="text-align:right;">20</td><td style="text-align:right;">120,000,000</td></tr>
<tr><td><span style="background-color:#6f42c1;color:white;padding:2px 8px;border-radius:3px;">Purple</span></td><td style="text-align:right;">10,000,000</td><td style="text-align:right;">50</td><td style="text-align:right;">500,000,000</td></tr>
<tr><td><span style="background-color:#ffc107;color:black;padding:2px 8px;border-radius:3px;">Yellow</span></td><td style="text-align:right;">8,000,000</td><td style="text-align:right;">100</td><td style="text-align:right;">800,000,000</td></tr>
<tr><td><span style="background-color:#fd7e14;color:white;padding:2px 8px;border-radius:3px;">Orange</span></td><td style="text-align:right;">4,000,000</td><td style="text-align:right;">500</td><td style="text-align:right;">2,000,000,000</td></tr>
<tr style="font-weight:bold;"><td>Total number of '<span class="double-strike">M</span>' game stamps:</td><td style="text-align:right;">35,149,999</td><td></td><td style="text-align:right;">Total value: 3,491,499,990</td></tr>
